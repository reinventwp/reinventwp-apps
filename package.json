{
  "name": "reinventwp-apps-dashboard",
  "version": "2.0.0",
  "description": "The shared \"Reinvent WP Apps\" admin page, copied into each WordPress.org-approved Reinvent WP plugin.",
  "private": true,
  "scripts": {
    "dev": "./scripts/dev-data.sh && webpack serve --mode development",
    "dev:data": "./scripts/dev-data.sh",
    "build": "webpack --mode production && ./scripts/copy-bot-to-website.sh",
    "install-into": "./scripts/install-into.sh",
    "type": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@types/react": "19",
    "@types/react-dom": "19",
    "html-webpack-plugin": "^5.6.8",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.14",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "framer-motion": "^12.43.0",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
